# Copy this file to .env.local and replace the placeholders with values from:
# Supabase Dashboard -> your project -> Connect
#
# IMPORTANT: the publishable key is safe to use in browser code when Row Level
# Security is configured. Never put a Supabase service-role key in a Vite app.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
